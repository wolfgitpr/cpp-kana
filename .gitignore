# Ignore rules. Every entry here should answer "what generates this?", because an
# ignore line nobody can explain is how a real file ends up invisible to git.

# --- compiled output, wherever a compiler puts it ---------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.d
*.gch
*.pch
*.mod

# --- build trees ------------------------------------------------------------------------
# CMakePresets.json puts every build under .tmp/ so nothing IDE-shaped grows in the
# repository root. The rest are the shapes older tools still produce.
.tmp/
build/
cmake-build*/
out/

# --- editor and OS ---
.DS_Store
*/.DS_Store
*.user
*.lnk
.vscode
.idea
.vs
.cache
cache/
CMakeSettings.json

# --- cpp-kana2: scratch and research output that is not project content ----------------
# Only what `git ls-files` tracks is the project. Everything below is regenerated by a
# command named in the comment above it.

# Packaging output: `pip wheel ./python -w .tmp/dist`, `dotnet pack -o .tmp/nupkg`.
dist/
*.whl
*.nupkg
*.egg-info/

# Python: byte-code caches, and the two files python/tools/build_native.py stages. The
# package directory itself stays tracked, so these are file rules, not "python/".
__pycache__/
*.pyc
.pytest_cache/
python/cpp_kana2/_version.py
python/cpp_kana2/_native/

# C#: build info generated by csharp/tools/emit_build_info.py, and project output.
csharp/CppKana2/version.props
csharp/CppKana2/BuildInfo.g.cs
csharp/**/bin/
csharp/**/obj/
csharp/**/TestResults/

# --- local overlays ---------------------------------------------------------------------
# The vcpkg port for this package is maintained beside the repository, not in it: it is a tree the user
# owns, its SHA512 only becomes fillable once the branch is pushed, and committing it by accident would
# publish a port that points at nothing.
/cpp-kana2/
/vcpkg
