<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TARGETS. net7.0 and net10.0 are the two runtimes this repository can actually build and run
         against on the development machine (dotnet list-sdks: 7.0.302 and 10.0.402). A third, older
         target would be a promise the build cannot check, so it is not advertised. -->
    <TargetFrameworks>net7.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- net7.0 is out of support (NETSDK1138) but is kept because the development machine and the CI image
         both have its runtime installed; the warning is noise here, not a defect. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 ("missing XML comment for publicly visible type") is suppressed rather than satisfied: the
         documentation file is generated because a package should ship one, not because every property needs
         a comment to build. The types that carry rules do have them; the rest are self-describing. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- R15/K6: the managed surface carries the generation token too, because two generations under one
         PackageId are silently merged by NuGet. -->
    <AssemblyName>CppKana2</AssemblyName>
    <RootNamespace>CppKana2</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CppKana2</PackageId>
    <Description>C# binding for cpp-kana2 (Japanese kana to Hepburn romaji) over its C ABI. The native library is loaded from the package's runtimes/&lt;rid&gt;/native/ directory.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wolfgitpr/cpp-kana</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wolfgitpr/cpp-kana</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>japanese;kana;hiragana;katakana;romaji;hepburn;nlp;native;csharp</PackageTags>
    <!-- nuget.org shows this README on the package page; without it the page is a description and a licence. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.0 -- first release of cpp-kana2: Hepburn engine, C ABI (cppk2_*), Python and C# bindings.</PackageReleaseNotes>
    <Authors>CppKana2</Authors>
  </PropertyGroup>

  <!-- Generated by csharp/tools/emit_build_info.py; never tracked. A missing file must fail the build:
       the native library's file name is a compile-time constant (DllImport needs one), and a silent
       fallback to a guessed name produces a package that installs and cannot load. -->
  <!-- BuildInfo.g.cs is picked up by the SDK's default glob; do NOT add it explicitly, or the build fails
       with NETSDK1022 (duplicate Compile item). -->

  <Import Project="version.props" Condition="Exists('version.props')" />

  <Target Name="RequireGeneratedBuildInfo" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/BuildInfo.g.cs')"
           Text="csharp/CppKana2/BuildInfo.g.cs or version.props is missing. Run: python csharp/tools/emit_build_info.py --native &lt;built native library&gt;" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/version.props')"
           Text="csharp/CppKana2/version.props is missing. Run: python csharp/tools/emit_build_info.py --native &lt;built native library&gt;" />
  </Target>

  <!-- PACKAGING. The rid is REQUIRED, not defaulted: guessing it produces a package that installs
       cleanly and then fails on the user's machine. -->
  <PropertyGroup>
    <CppKana2Rid Condition="'$(CppKana2Rid)' == ''">$(CPPK2_NATIVE_RID)</CppKana2Rid>
    <CppKana2NativeDir Condition="'$(CppKana2NativeDir)' == ''">$(CPPK2_NATIVE_DIR)</CppKana2NativeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Every platform's native library, laid out by the release workflow as runtimes/<rid>/native/<library>.
    A package carrying only win-x64 restores on Linux and then fails at the first P/Invoke; carrying one
    directory per RID means a C# project anywhere gets the same CppKana2 version and the right library.
  -->
  <ItemGroup Condition="Exists('runtimes')">
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(CppKana2Rid)' != '' and '$(CppKana2NativeDir)' != ''">
    <None Include="$(CppKana2NativeDir)\*cpp-kana2.dll" Pack="true" PackagePath="runtimes/$(CppKana2Rid)/native/" />
    <None Include="$(CppKana2NativeDir)\*cpp-kana2.so" Pack="true" PackagePath="runtimes/$(CppKana2Rid)/native/" />
    <None Include="$(CppKana2NativeDir)\*cpp-kana2.dylib" Pack="true" PackagePath="runtimes/$(CppKana2Rid)/native/" />
  </ItemGroup>

  <Target Name="CppKana2PackRequiresInputs" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(CppKana2Rid)' == ''"
           Text="CppKana2Rid is required to pack: pass -p:CppKana2Rid=win-x64 (or linux-x64 / osx-arm64 / ...)." />
    <Error Condition="'$(CppKana2NativeDir)' == ''"
           Text="CppKana2NativeDir is required to pack: pass -p:CppKana2NativeDir=&lt;dir with the built library&gt;." />
    <ItemGroup>
      <_CppKana2PackCheck Include="$(CppKana2NativeDir)\*cpp-kana2.dll;$(CppKana2NativeDir)\*cpp-kana2.so;$(CppKana2NativeDir)\*cpp-kana2.dylib" />
    </ItemGroup>
    <Error Condition="'@(_CppKana2PackCheck)' == ''"
           Text="no cpp-kana2 native library in '$(CppKana2NativeDir)' (looked for *cpp-kana2.dll / .so / .dylib)" />
  </Target>

</Project>
